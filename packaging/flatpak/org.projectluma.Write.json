{
  "app-id": "org.projectluma.Write",
  "runtime": "org.projectluma.Platform",
  "runtime-version": "44",
  "sdk": "org.projectluma.Sdk",
  "command": "luma-write",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--env=LUMA_LIBREOFFICE_PROGRAM=/app/lib/office/lib64/libreoffice/program",
    "--env=LD_LIBRARY_PATH=/app/lib/office/lib64/libreoffice/program:/app/lib:/app/lib/office/lib64"
  ],
  "add-extensions": {
    "org.projectluma.Platform.Office": {
      "directory": "lib/office",
      "version": "44",
      "add-ld-path": "lib64",
      "no-autodownload": false,
      "autodelete": false
    }
  },
  "modules": [
    {
      "name": "luma-platform",
      "buildsystem": "meson",
      "subdir": "vendor/luma-platform",
      "config-opts": [
        "--buildtype=release"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/SimplyLuma/Write.git",
          "tag": "v0.1.0"
        }
      ]
    },
    {
      "name": "write",
      "buildsystem": "meson",
      "config-opts": [
        "--buildtype=release",
        "-Ddesktop=enabled",
        "-Dlibreofficekit=enabled",
        "-Ddeveloper_tools=false"
      ],
      "post-install": [
        "install -d /app/lib/office /app/share/licenses/org.projectluma.Write",
        "cp -r LICENSES /app/share/licenses/org.projectluma.Write/",
        "install -m644 LICENSE.md THIRD_PARTY_NOTICES.md /app/share/licenses/org.projectluma.Write/"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/SimplyLuma/Write.git",
          "tag": "v0.1.0"
        }
      ]
    }
  ]
}
