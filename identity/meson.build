# All replaceable product identity and document-type labels live here. Keep
# these values out of source, desktop metadata, packaging, and templates.
luma_suite_name = 'Luma'
luma_app_name = 'Write'
luma_app_id = 'org.projectluma.Write'
luma_icon_name = luma_app_id

# The live development profile runs beside the installed Write: its own
# application ID keeps D-Bus activation, settings and the dock entry separate,
# while it keeps Write's icon.
if get_option('profile') == 'live'
  luma_app_name = 'Write Live'
  luma_app_id = 'org.projectluma.WriteLive'
endif
luma_docx_label = 'Word Document'
luma_odt_label = 'OpenDocument Text'
luma_doc_label = 'Legacy Word 97–2003 Document'
luma_pdf_label = 'PDF Document'
